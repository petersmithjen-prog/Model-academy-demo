{
  "entities": {
    "StudentProfile": {
      "title": "StudentProfile",
      "description": "Student account profile in users/{uid}.",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["student"] },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "roll": { "type": "string", "minLength": 1, "maxLength": 30 },
        "studentId": { "type": "string", "minLength": 1, "maxLength": 40 },
        "class": { "type": "string", "minLength": 1, "maxLength": 40 },
        "section": { "type": "string", "minLength": 1, "maxLength": 40 },
        "phone": { "type": "string", "minLength": 11, "maxLength": 11, "pattern": "^01[0-9]{9}$" },
        "email": { "type": "string", "format": "email", "minLength": 5, "maxLength": 160 },
        "studentKey": { "type": "string", "minLength": 5, "maxLength": 128, "pattern": "^[a-z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["role", "name", "roll", "studentId", "class", "section", "phone", "email", "studentKey", "createdAt"]
    },
    "GuardianProfile": {
      "title": "GuardianProfile",
      "description": "Guardian account profile in users/{uid} with linked children list.",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["guardian"] },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "phone": { "type": "string", "minLength": 11, "maxLength": 11, "pattern": "^01[0-9]{9}$" },
        "email": { "type": "string", "format": "email", "minLength": 5, "maxLength": 160 },
        "children": { "type": "array", "description": "Bounded list of 1 to 6 children with link metadata." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["role", "name", "phone", "email", "children", "createdAt"]
    },
    "TeacherProfile": {
      "title": "TeacherProfile",
      "description": "Teacher account profile in users/{uid} requiring school office approval.",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["teacher"] },
        "approved": { "type": "boolean" },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "phone": { "type": "string", "minLength": 11, "maxLength": 11, "pattern": "^01[0-9]{9}$" },
        "email": { "type": "string", "format": "email", "minLength": 5, "maxLength": 160 },
        "designation": { "type": "string", "minLength": 2, "maxLength": 80 },
        "subjects": { "type": "string", "minLength": 1, "maxLength": 200 },
        "classes": { "type": "array", "description": "Bounded list of classes taught." },
        "employeeId": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["role", "approved", "name", "phone", "email", "designation", "subjects", "classes", "employeeId", "createdAt"]
    },
    "StudentRegistryEntry": {
      "title": "StudentRegistryEntry",
      "description": "PII-free uniqueness lock ensuring one student account per Class + Roll + ID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "createdAt"]
    },
    "LinkRequest": {
      "title": "LinkRequest",
      "description": "Guardian-to-student link approval request matched by deterministic studentKey.",
      "type": "object",
      "properties": {
        "guardianUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "guardianName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "guardianPhone": { "type": "string", "minLength": 11, "maxLength": 11, "pattern": "^01[0-9]{9}$" },
        "studentKey": { "type": "string", "minLength": 5, "maxLength": 128, "pattern": "^[a-z0-9_\\-]+$" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "revoked"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["guardianUid", "guardianName", "guardianPhone", "studentKey", "status", "createdAt", "updatedAt"]
    },
    "StudentRosterEntry": {
      "title": "StudentRosterEntry",
      "description": "Non-PII class roster record keyed by studentKey so approved teachers can view students in their classes.",
      "type": "object",
      "properties": {
        "studentKey": { "type": "string", "minLength": 5, "maxLength": 128, "pattern": "^[a-z0-9_\\-]+$" },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "roll": { "type": "string", "minLength": 1, "maxLength": 30 },
        "studentId": { "type": "string", "minLength": 1, "maxLength": 40 },
        "class": { "type": "string", "minLength": 1, "maxLength": 40 },
        "section": { "type": "string", "minLength": 1, "maxLength": 40 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentKey", "uid", "name", "roll", "studentId", "class", "section", "updatedAt"]
    },
    "GuardianLinkGrant": {
      "title": "GuardianLinkGrant",
      "description": "Deterministic guardianUid__studentKey grant document authorizing guardian read access to studentRecords.",
      "type": "object",
      "properties": {
        "guardianUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "studentKey": { "type": "string", "minLength": 5, "maxLength": 128, "pattern": "^[a-z0-9_\\-]+$" },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "active": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["guardianUid", "studentKey", "requestId", "active", "updatedAt"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Daily student attendance entry under studentRecords/{studentKey}/attendance/{dateKey}.",
      "type": "object",
      "properties": {
        "studentKey": { "type": "string", "minLength": 5, "maxLength": 128 },
        "studentClass": { "type": "string", "minLength": 1, "maxLength": 40 },
        "studentSection": { "type": "string", "minLength": 1, "maxLength": 40 },
        "date": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "status": { "type": "string", "enum": ["present", "absent", "late"] },
        "teacherUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "teacherName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentKey", "studentClass", "studentSection", "date", "status", "teacherUid", "teacherName", "updatedAt"]
    },
    "ResultRecord": {
      "title": "ResultRecord",
      "description": "Exam subject result under studentRecords/{studentKey}/results/{resultId}.",
      "type": "object",
      "properties": {
        "studentKey": { "type": "string", "minLength": 5, "maxLength": 128 },
        "studentClass": { "type": "string", "minLength": 1, "maxLength": 40 },
        "studentSection": { "type": "string", "minLength": 1, "maxLength": 40 },
        "examName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "subject": { "type": "string", "minLength": 1, "maxLength": 80 },
        "marks": { "type": "number" },
        "fullMarks": { "type": "number" },
        "grade": { "type": "string", "minLength": 1, "maxLength": 10 },
        "teacherUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "teacherName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentKey", "studentClass", "studentSection", "examName", "subject", "marks", "fullMarks", "grade", "teacherUid", "teacherName", "updatedAt"]
    },
    "TeacherNote": {
      "title": "TeacherNote",
      "description": "Individual student note under studentRecords/{studentKey}/notes/{noteId}.",
      "type": "object",
      "properties": {
        "studentKey": { "type": "string", "minLength": 5, "maxLength": 128 },
        "studentClass": { "type": "string", "minLength": 1, "maxLength": 40 },
        "studentSection": { "type": "string", "minLength": 1, "maxLength": 40 },
        "text": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "date": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "category": { "type": "string", "maxLength": 40 },
        "teacherUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "teacherName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentKey", "studentClass", "studentSection", "text", "date", "category", "teacherUid", "teacherName", "createdAt"]
    },
    "HomeworkItem": {
      "title": "HomeworkItem",
      "description": "Class homework entry under studentRecords/{studentKey}/homework/{homeworkId}.",
      "type": "object",
      "properties": {
        "studentKey": { "type": "string", "minLength": 5, "maxLength": 128 },
        "studentClass": { "type": "string", "minLength": 1, "maxLength": 40 },
        "studentSection": { "type": "string", "minLength": 1, "maxLength": 40 },
        "subject": { "type": "string", "minLength": 1, "maxLength": 80 },
        "text": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "dueDate": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "teacherUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "teacherName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentKey", "studentClass", "studentSection", "subject", "text", "dueDate", "teacherUid", "teacherName", "createdAt"]
    },
    "SchoolNotice": {
      "title": "SchoolNotice",
      "description": "School-wide notice posted by admin, readable by any signed-in user.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 2, "maxLength": 160 },
        "text": { "type": "string", "minLength": 2, "maxLength": 3000 },
        "date": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "authorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "text", "date", "authorUid", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/StudentProfile" },
      "description": "Private user profiles (student, guardian, teacher, or manually-provisioned admin). Readable only by owner or admin."
    },
    "/studentRegistry/{registryKey}": {
      "schema": { "$ref": "#/entities/StudentRegistryEntry" },
      "description": "Deterministic Class + Roll + ID claim records preventing duplicate student registrations."
    },
    "/studentRoster/{studentKey}": {
      "schema": { "$ref": "#/entities/StudentRosterEntry" },
      "description": "Non-PII class/section roster entries readable by approved teachers of that class, owning student, and admin."
    },
    "/linkRequests/{requestId}": {
      "schema": { "$ref": "#/entities/LinkRequest" },
      "description": "Guardian link requests readable by requesting guardian, matching student (via studentKey), or admin."
    },
    "/guardianLinks/{linkId}": {
      "schema": { "$ref": "#/entities/GuardianLinkGrant" },
      "description": "Active guardian link grants keyed by {guardianUid}__{studentKey}."
    },
    "/studentRecords/{studentKey}/attendance/{dateKey}": {
      "schema": { "$ref": "#/entities/AttendanceRecord" },
      "description": "Student attendance records."
    },
    "/studentRecords/{studentKey}/results/{resultId}": {
      "schema": { "$ref": "#/entities/ResultRecord" },
      "description": "Student exam results."
    },
    "/studentRecords/{studentKey}/notes/{noteId}": {
      "schema": { "$ref": "#/entities/TeacherNote" },
      "description": "Teacher notes visible to student, approved guardians, class teachers, and admin."
    },
    "/studentRecords/{studentKey}/homework/{homeworkId}": {
      "schema": { "$ref": "#/entities/HomeworkItem" },
      "description": "Homework assignments stored per studentKey."
    },
    "/notices/{noticeId}": {
      "schema": { "$ref": "#/entities/SchoolNotice" },
      "description": "School-wide notices readable by signed-in users and writable only by admin."
    }
  }
}
